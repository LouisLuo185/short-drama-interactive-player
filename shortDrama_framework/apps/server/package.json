{
  "name": "@short-drama/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "ocr": "tsx src/cli/runVideoOcr.ts",
    "ocr:paddle": "tsx src/cli/runPaddleOcr.ts",
    "import:pipeline": "tsx src/cli/runSmartImportPipeline.ts",
    "danmaku:signals": "tsx src/cli/runDanmakuSignals.ts",
    "asr:story-context": "tsx src/cli/runStoryContextBuilder.ts",
    "asr:refined-highlight": "tsx src/cli/runRefinedHighlightPipeline.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
